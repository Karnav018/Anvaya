JWT_EXPIRE_MINUTES=10080

# App
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Encryption key for env vars (32 bytes hex = 64 chars)
ENCRYPTION_KEY=change-this-to-a-64-char-hex-string
