# ============================================
# REQUIRED: Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
# Recommended: Use Neon, Supabase, or any managed PostgreSQL provider
# Example: postgresql://anvaya_user:password@localhost:5432/anvaya
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/anvaya?sslmode=require

# ============================================
# REQUIRED: JWT Authentication
# ============================================
# Generate a secure random secret (256 bits recommended)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-256-bit-secret

# JWT algorithm (don't change unless you know what you're doing)
JWT_ALGORITHM=HS256

# JWT token expiry in minutes (10080 = 7 days)
JWT_EXPIRE_MINUTES=10080

# ============================================
# REQUIRED: Application URLs
# ============================================
# Backend API URL (used for CORS and redirects)
APP_URL=http://localhost:8000

# Frontend URL (used for CORS whitelist)
# In production, set to your actual domain: https://anvaya.yourdomain.com
FRONTEND_URL=http://localhost:5173

# ============================================
# OPTIONAL: Encryption Key
# ============================================
# Used for encrypting sensitive data (future feature)
# Generate with: openssl rand -hex 32
# Leave default for development
ENCRYPTION_KEY=change-this-to-a-64-char-hex-string

# ============================================
# OPTIONAL: Environment
# ============================================
# Options: development, staging, production
ENVIRONMENT=development

# ============================================
# OPTIONAL: Logging
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
