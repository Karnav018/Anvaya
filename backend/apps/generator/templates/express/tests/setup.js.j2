const { sequelize } = require('../db');

// Setup test database
beforeAll(async () => {
  // Connect to test database
  await sequelize.authenticate();
  
  // Sync database schema (creates tables)
  await sequelize.sync({ force: true });
  
  console.log('✅ Test database connected and synced');
});

afterAll(async () => {
  // Clean up and close connections
  await sequelize.close();
  console.log('🧹 Test database connections closed');
});

// Clean up between tests
afterEach(async () => {
  // Clear all tables but keep schema
  const models = Object.values(sequelize.models);
  for (const model of models) {
    await model.destroy({ where: {}, truncate: true });
  }
});

// Global test utilities
global.testHelpers = {
  // Create test data easily
  async createTestData(model, data = {}) {
    const defaultData = {
      createdAt: new Date(),
      updatedAt: new Date(),
      ...data
    };
    return await model.create(defaultData);
  },

  // Wait for async operations
  async sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  },

  // Generate random test data
  randomString(length = 10) {
    return Math.random().toString(36).substring(2, 2 + length);
  },

  randomEmail() {
    return `test-${this.randomString(8)}@example.com`;
  },

  randomNumber(min = 1, max = 100) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }
};

module.exports = { sequelize };