const express = require('express');
const router = express.Router();

// Import error handling and validation
const { 
  asyncHandler, 
  ValidationError, 
  NotFoundError, 
  ConflictError 
} = require('../middleware/errors');

const { 
  validateBody, 
  validateQuery, 
  validateParams 
} = require('../middleware/validation');

// Import route-specific validation schemas
const {
  {% if route.method in ['POST', 'PUT', 'PATCH'] %}
  {{ route.safe_name }}BodySchema,
  {% endif %}
  {% if route.method == 'GET' and route.db_action == 'findAll' %}
  {{ route.safe_name }}QuerySchema,
  {% endif %}
  {% if route.method in ['GET', 'PUT', 'PATCH', 'DELETE'] and route.db_action in ['findOne', 'update', 'delete'] %}
  {{ route.safe_name }}ParamsSchema,
  {% endif %}
} = require('../validators/{{ route.file_name }}');

{% if route.has_auth %}
const { {% if route.auth_strategy == 'jwt' %}verifyJWT{% else %}verifyApiKey{% endif %} } = require('../middleware/auth');
{% endif %}

{% if route.has_database %}
const {{ route.db_model }} = require('../models/{{ route.db_model }}');
{% endif %}

{% if route.has_axios %}
const axios = require('axios');
{% endif %}

{% if route.has_redis %}
const { createClient } = require('redis');
const redisClient = createClient({ url: process.env.REDIS_URL || 'redis://localhost:6379' });
redisClient.connect().catch(console.error);
{% endif %}

{% if route.has_email %}
const nodemailer = require('nodemailer');
const transporter = nodemailer.createTransport({
  host: process.env.SMTP_HOST,
  auth: { user: process.env.SMTP_USER, pass: process.env.SMTP_PASS }
});
{% endif %}

{% if route.has_openai %}
const OpenAI = require('openai');
const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });
{% endif %}

{% if route.has_stripe %}
const Stripe = require('stripe');
const stripe = Stripe(process.env.STRIPE_SECRET_KEY);
{% endif %}

{% if route.has_upload %}
const multer = require('multer');
const { S3Client } = require('@aws-sdk/client-s3');
const multerS3 = require('multer-s3');
const s3 = new S3Client({ region: process.env.AWS_REGION });
const upload = multer({
  storage: multerS3({
    s3: s3,
    bucket: '{{ route.upload_bucket }}',
    metadata: function (req, file, cb) { cb(null, { fieldName: file.fieldname }); },
    key: function (req, file, cb) { cb(null, Date.now().toString() + '-' + file.originalname); }
  })
});
{% endif %}

// Main route handler
router.{{ route.method | lower }}('/', 
{% if route.method in ['GET', 'PUT', 'PATCH', 'DELETE'] and route.db_action in ['findOne', 'update', 'delete'] %}
  validateParams({{ route.safe_name }}ParamsSchema),
{% endif %}
{% if route.method == 'GET' and route.db_action == 'findAll' %}
  validateQuery({{ route.safe_name }}QuerySchema),
{% endif %}
{% if route.method in ['POST', 'PUT', 'PATCH'] %}
  validateBody({{ route.safe_name }}BodySchema),
{% endif %}
{% if route.has_auth %}
  {% if route.auth_strategy == 'jwt' %}verifyJWT{% else %}verifyApiKey{% endif %},
{% endif %}
{% if route.has_upload %}
  upload.single('file'),
{% endif %}
  asyncHandler(async (req, res) => {
    {% if route.has_redis %}
    // Check cache first
    const cacheKey = {{ route.cache_key }};
    try {
      const cached = await redisClient.get(cacheKey);
      if (cached) {
        return res.status(200).json({
          success: true,
          data: JSON.parse(cached),
          cached: true
        });
      }
    } catch (cacheErr) {
      console.warn('Cache read error:', cacheErr.message);
    }
    {% endif %}

    let data;

    {% if route.has_database %}
    // Database operation
    try {
      {% if route.db_action == 'findAll' %}
      const { page = 1, limit = 10, sort, order = 'asc' } = req.query;
      const offset = (page - 1) * limit;
      
      const options = {
        limit: parseInt(limit),
        offset: parseInt(offset),
        order: sort ? [[sort, order.toUpperCase()]] : [['createdAt', 'DESC']]
      };
      
      const result = await {{ route.db_model }}.findAndCountAll(options);
      data = {
        items: result.rows,
        total: result.count,
        page: parseInt(page),
        limit: parseInt(limit),
        totalPages: Math.ceil(result.count / limit)
      };
      {% elif route.db_action == 'findOne' %}
      const { id } = req.params;
      data = await {{ route.db_model }}.findByPk(id);
      if (!data) {
        throw new NotFoundError('{{ route.db_model }}');
      }
      {% elif route.db_action == 'create' %}
      try {
        data = await {{ route.db_model }}.create(req.body);
      } catch (err) {
        if (err.name === 'SequelizeUniqueConstraintError') {
          throw new ConflictError('{{ route.db_model }} already exists', err.errors[0]?.path);
        }
        throw err;
      }
      {% elif route.db_action == 'update' %}
      const { id } = req.params;
      const [updatedCount] = await {{ route.db_model }}.update(req.body, { 
        where: { id },
        returning: true 
      });
      
      if (updatedCount === 0) {
        throw new NotFoundError('{{ route.db_model }}');
      }
      
      data = await {{ route.db_model }}.findByPk(id);
      {% elif route.db_action == 'delete' %}
      const { id } = req.params;
      const deletedCount = await {{ route.db_model }}.destroy({ where: { id } });
      
      if (deletedCount === 0) {
        throw new NotFoundError('{{ route.db_model }}');
      }
      
      data = { message: '{{ route.db_model }} deleted successfully', id };
      {% endif %}
    } catch (dbErr) {
      console.error('Database error:', dbErr);
      throw dbErr;
    }
    {% else %}
    // Default success response
    data = { message: 'Operation successful' };
    {% endif %}

    {% if route.has_fetch %}
    // External API call
    try {
      const fetchResponse = await axios({
        method: '{{ route.fetch_method }}',
        url: '{{ route.fetch_url }}',
        data: req.body,
        timeout: 10000
      });
      data.externalData = fetchResponse.data;
    } catch (apiErr) {
      console.warn('External API error:', apiErr.message);
      data.externalError = 'External service unavailable';
    }
    {% endif %}

    {% if route.has_ai %}
    // AI Processing
    try {
      const completion = await openai.chat.completions.create({
        model: "gpt-4",
        messages: [
          { role: "system", content: "{{ route.ai_prompt }}" },
          { role: "user", content: JSON.stringify(data) }
        ],
        max_tokens: 500
      });
      data.aiProcessing = completion.choices[0].message.content;
    } catch (aiErr) {
      console.warn('AI processing error:', aiErr.message);
      data.aiError = 'AI processing unavailable';
    }
    {% endif %}

    {% if route.has_email %}
    // Send email notification
    try {
      await transporter.sendMail({
        from: '"Anvaya API" <no-reply@anvaya.dev>',
        to: {{ route.email_to }},
        subject: "{{ route.email_subject }}",
        html: `<h2>API Notification</h2><pre>${JSON.stringify(data, null, 2)}</pre>`
      });
      data.emailSent = true;
    } catch (mailErr) {
      console.warn('Email send error:', mailErr.message);
      data.emailError = 'Email notification failed';
    }
    {% endif %}

    {% if route.has_payment %}
    // Create Stripe checkout session
    try {
      const session = await stripe.checkout.sessions.create({
        payment_method_types: ['card'],
        line_items: [{
          price_data: {
            currency: 'usd',
            product_data: { name: '{{ route.payment_product_id }}' },
            unit_amount: req.body.amount || 2000,
          },
          quantity: 1,
        }],
        mode: '{{ route.payment_mode }}',
        success_url: `${req.protocol}://${req.get('host')}/success`,
        cancel_url: `${req.protocol}://${req.get('host')}/cancel`,
      });
      data.paymentUrl = session.url;
      data.sessionId = session.id;
    } catch (stripeErr) {
      console.warn('Stripe error:', stripeErr.message);
      throw new ValidationError('Payment processing failed');
    }
    {% endif %}

    {% if route.has_upload %}
    // File upload handling
    if (req.file) {
      data.fileUpload = {
        url: req.file.location,
        key: req.file.key,
        bucket: req.file.bucket,
        size: req.file.size,
        mimeType: req.file.mimetype
      };
    }
    {% endif %}

    {% if route.has_redis %}
    // Cache the result
    try {
      await redisClient.setEx(
        cacheKey, 
        {{ route.cache_ttl }}, 
        JSON.stringify(data)
      );
    } catch (cacheErr) {
      console.warn('Cache write error:', cacheErr.message);
    }
    {% endif %}

    // Send response
    const response = {
      success: true,
      {% if route.response_body == 'data' %}
      data,
      {% elif route.response_body == 'message' %}
      message: 'Operation completed successfully',
      {% elif route.response_body == 'custom' %}
      {{ route.custom_body | default('data') }},
      {% else %}
      data,
      {% endif %}
      timestamp: new Date().toISOString()
    };

    res.status({{ route.response_status }}).json(response);
  })
);

module.exports = router;