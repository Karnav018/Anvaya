const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
require('express-async-errors');
require('dotenv').config();

const { errorHandler, notFoundHandler } = require('./middleware/errors');
{% if has_database %}
const { sequelize } = require('./models');
{% endif %}

const app = express();
const PORT = process.env.PORT || 3000;

// Security middleware
app.use(helmet());
app.use(cors());

// Body parsing middleware
app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true }));

// Routes
{% for route in routes %}
const {{ route.safe_name }}Router = require('./routes/{{ route.file_name }}');
app.use('{{ route.path }}', {{ route.safe_name }}Router);
{% endfor %}

// Health check
app.get('/health', (req, res) => {
  res.json({ 
    status: 'ok', 
    timestamp: new Date().toISOString(),
    generated_by: 'Anvaya Visual API Builder',
    version: '1.0.0'
  });
});

// 404 handler (must be after all routes)
app.use(notFoundHandler);

// Global error handler (must be last)
app.use(errorHandler);

function onListen() {
  console.log(`🚀 Server running on http://localhost:${PORT}`);
  console.log(`📚 Generated by Anvaya — Visual API Builder`);
  console.log(`🏥 Health check: http://localhost:${PORT}/health`);
}
{% if has_database %}

// Connect to the DB and ensure the schema exists, then start serving.
// Note: sequelize.sync() is convenient for dev; use migrations in production.
async function start() {
  try {
    await sequelize.authenticate();
    await sequelize.sync();
    console.log('✅ Database connected & schema synced');
  } catch (err) {
    console.error('❌ Database initialization failed:', err.message);
    process.exit(1);
  }
  app.listen(PORT, onListen);
}

start();
{% else %}

app.listen(PORT, onListen);
{% endif %}
